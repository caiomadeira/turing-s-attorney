; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Turing's Attorney"
run/main_scene="res://game/scenes/game.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Dialogic="*uid://ds2q0uclmolvu"
GameState="*res://game/autoload/game_state.gd"
Inventory="*res://game/autoload/inventory.gd"
SceneRouter="*res://game/autoload/scene_router.gd"
DialogueDirector="*res://game/autoload/dialogue_director.gd"

[dialogic]

directories/dch_directory={
"Bert": "res://game/dialogic/characters/Bert/Bert.dch",
"Juiz": "res://game/dialogic/characters/Juiz/Juiz.dch",
"Pericles": "res://game/dialogic/characters/Pericles/Pericles.dch",
"Testemunha": "res://game/dialogic/characters/Testemunha/Testemunha.dch"
}
directories/dtl_directory={
"apartamento_entrada": "res://game/dialogic/timelines/apartamento_entrada.dtl",
"computador": "res://game/dialogic/timelines/computador.dtl",
"corredor_entrada": "res://game/dialogic/timelines/corredor_entrada.dtl",
"dobradicas": "res://game/dialogic/timelines/dobradicas.dtl",
"dobradicas_vistas": "res://game/dialogic/timelines/dobradicas_vistas.dtl",
"filtro": "res://game/dialogic/timelines/filtro.dtl",
"intro": "res://game/dialogic/timelines/intro.dtl",
"julgamento": "res://game/dialogic/timelines/julgamento.dtl",
"mesa_vazia": "res://game/dialogic/timelines/mesa_vazia.dtl",
"office_door_locked": "res://game/dialogic/timelines/office_door_locked.dtl",
"olho_magico": "res://game/dialogic/timelines/olho_magico.dtl",
"olho_magico_visto": "res://game/dialogic/timelines/olho_magico_visto.dtl",
"porta": "res://game/dialogic/timelines/porta.dtl",
"portaria_entrada": "res://game/dialogic/timelines/portaria_entrada.dtl",
"porteiro_depois": "res://game/dialogic/timelines/porteiro_depois.dtl",
"tapete": "res://game/dialogic/timelines/tapete.dtl",
"tapete_vazio": "res://game/dialogic/timelines/tapete_vazio.dtl",
"timeline_1": "res://game/dialogic/timelines/timeline_1.dtl",
"timeline_2": "res://game/dialogic/timelines/timeline_2.dtl"
}
layout/style_directory={
"": "res://game/dialogic/styles/textbox.tres",
"textbox": "res://game/dialogic/styles/textbox.tres"
}
glossary/default_case_sensitive=true
layout/style_list=["res://game/dialogic/styles/textbox.tres"]
layout/default_style="res://game/dialogic/styles/textbox.tres"
variables={}
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.0
animations/join_default_wait=true
animations/leave_default_length=0.0
animations/leave_default_wait=true
animations/cross_fade_default_length=0.0
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}
history/visited_event_history_enabled=true
history/simple_history_enabled=true
text/autocolor_names=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
mouse_cursor/custom_image="res://assets/kenney_cursor-pack/PNG/Outline/Default/gauntlet_point.png"
mouse_cursor/custom_image_hotspot=Vector2(10, 6)
window/size/min_width=1280
window/size/min_height=720

[dotnet]

project/assembly_name="Turing-s Attorney"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

[file_customization]

folder_colors={
"res://game/dialogic/timelines/": "orange"
}

